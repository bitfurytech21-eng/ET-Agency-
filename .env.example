# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Application Settings
PORT=3000
NODE_ENV=development
PAYMENT_MODE=manual
JWT_SECRET=dev-secret-change-me

# Payment Providers (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Email / SMTP Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Easy Travel Lodging <noreply@example.com>"

# Maps & Location Tools
GOOGLE_MAPS_API_KEY=

# Admin Configuration
ADMIN_EMAIL=hello@easytravellodging.com

# Smartsup Live Chat Integration
VITE_SMARTSUP_KEY=easy_travel_lodging_smartsup
